<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- electron-builder's defaults: V8 needs JIT, and ad-hoc signed frameworks fail library validation. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Voice input. Without it the hardened runtime denies the microphone without asking. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Computer use: typing through System Events when posting the characters doesn't work. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
